DATABASE_URL=postgresql+psycopg://content:content@db:5432/content
TEST_DATABASE_URL=postgresql+psycopg://content:content@db:5432/content_test

OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=

NEXT_PUBLIC_API_URL=http://localhost:8000

CORS_ORIGINS=http://localhost:3000

# Background job: fetch all active sources (and classify new ones when OPENAI_API_KEY is set).
# 0 disables the scheduler.
FETCH_INTERVAL_MINUTES=30
# Skip feed entries published more than N days ago (0 = no limit).
FETCH_MAX_AGE_DAYS=14
# Max candidates classified per classify-pending call / scheduler run.
CLASSIFY_BATCH_LIMIT=50

# --- Research engine ---
# Empty = same model as OPENAI_CLASSIFIER_MODEL.
OPENAI_RESEARCH_MODEL=
# manual = no search engine (add sources by URL in the panel); tavily = Tavily Search API.
SEARCH_PROVIDER=manual
TAVILY_API_KEY=
RESEARCH_MAX_EXTRA_SOURCES=5
# Character limits for content sent to the LLM (simple truncation, original article gets more room).
RESEARCH_MAX_CHARS_ORIGINAL=20000
RESEARCH_MAX_CHARS_PER_SOURCE=12000
RESEARCH_MAX_TOTAL_CHARS=60000
# USD per 1M tokens, JSON. Leave empty to use defaults from app/core/config.py.
# LLM_PRICING={"gpt-4.1-mini": {"input": 0.40, "output": 1.60}}

# --- Article writer ---
# Empty = OPENAI_RESEARCH_MODEL (-> OPENAI_CLASSIFIER_MODEL). A cheaper brief model + stronger writer works well,
# e.g. OPENAI_BRIEF_MODEL=gpt-4.1-mini, OPENAI_WRITER_MODEL=gpt-4.1
OPENAI_BRIEF_MODEL=
OPENAI_WRITER_MODEL=
WRITER_TIMEOUT_SECONDS=300
RESEARCH_TIMEOUT_SECONDS=300
