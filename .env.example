# Dev (`make up` / `make dev`): Laravel czyta apps/platform/.env (kopia apps/platform/.env.example),
# a ten plik ustawia tylko adres API wkompilowany w panel.
# Prod (`make deploy`, docker-compose.prod.yml): ten plik jest jedynym źródłem konfiguracji Laravela.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Produkcja ---
# Klucz szyfrowania sesji i haseł aplikacji WordPress. Wygeneruj raz i nie zmieniaj (zmiana = ponowne
# łączenie stron WP): docker compose exec platform php artisan key:generate --show
APP_NAME="Content Engine"
APP_KEY=
APP_LOCALE=pl
# Publiczne adresy API (za reverse proxy z TLS) i panelu, np. https://api.example.com i https://app.example.com.
APP_URL=
FRONTEND_URL=
# Ciasteczko sesji wspólne dla api. i app.: SESSION_DOMAIN=.example.com; SANCTUM_STATEFUL_DOMAINS=app.example.com.
SESSION_COOKIE=ce_session
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=20160
SANCTUM_STATEFUL_DOMAINS=
# Baza: DB_* składa compose z POSTGRES_*; hasło np. `openssl rand -hex 24`.
POSTGRES_USER=content
POSTGRES_PASSWORD=
POSTGRES_DB=content
# Adres:port na hoście. Domyślnie tylko localhost (za reverse proxy z TLS).
API_BIND=127.0.0.1:8000
WEB_BIND=127.0.0.1:3000

# --- Konta i koszty ---
ALLOW_REGISTRATION=true
# Miesięczny budżet AI workspace'u w USD (puste = bez limitu). Per workspace: make set-budget WORKSPACE=<id> USD=25.
DEFAULT_MONTHLY_BUDGET_USD=10

# --- Modele (puste = model poprzedniego etapu, ostatecznie OPENAI_CLASSIFIER_MODEL) ---
OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=gpt-4.1-mini
OPENAI_RESEARCH_MODEL=
OPENAI_BRIEF_MODEL=
OPENAI_WRITER_MODEL=
OPENAI_QA_MODEL=
OPENAI_AUTO_FIX_MODEL=

# --- RSS i research ---
# Automatyka (pobieranie RSS, ocena) jest ustawiana per workspace w panelu: Ustawienia -> Automatyka.
# false = główny wyłącznik: scheduler nie robi żadnych automatycznych przebiegów dla nikogo.
AUTOMATION_ENABLED=true
FETCH_MAX_AGE_DAYS=14
# manual = bez wyszukiwarki (źródła dodaje się w panelu); tavily = Tavily Search API.
SEARCH_PROVIDER=manual
TAVILY_API_KEY=
RESEARCH_MAX_EXTRA_SOURCES=5

# --- QA i Auto Fix ---
QA_PASS_SCORE=85
AUTO_FIX_MAX_CHANGE_RATIO=0.35
AUTO_FIX_MAX_ITERATIONS=2

# --- WordPress (połączenia per workspace w panelu: Ustawienia) ---
# true tylko dla lokalnego WP w sieci Dockera; w prod adresy WP muszą być publiczne (ochrona SSRF).
WORDPRESS_ALLOW_PRIVATE_URLS=false
# Opcjonalny jednorazowy import połączenia (make wordpress-import-prod); po imporcie usuń hasło z pliku.
WORDPRESS_URL=
WORDPRESS_API_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
