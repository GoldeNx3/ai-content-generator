DATABASE_URL=postgresql+psycopg://content:content@db:5432/content
TEST_DATABASE_URL=postgresql+psycopg://content:content@db:5432/content_test

OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=

NEXT_PUBLIC_API_URL=http://localhost:8000

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Osobny scheduler: pobiera RSS i zleca ocenę kolejce, gdy ustawiono klucz OpenAI.
# 0 disables the scheduler.
FETCH_INTERVAL_MINUTES=30
# Skip feed entries published more than N days ago (0 = no limit).
FETCH_MAX_AGE_DAYS=14
# Max candidates classified per classify-pending call / scheduler run.
CLASSIFY_BATCH_LIMIT=50

# --- Research engine ---
# Empty = same model as OPENAI_CLASSIFIER_MODEL.
OPENAI_RESEARCH_MODEL=
# manual = no search engine (add sources by URL in the panel); tavily = Tavily Search API.
SEARCH_PROVIDER=manual
TAVILY_API_KEY=
RESEARCH_MAX_EXTRA_SOURCES=5
# Character limits for content sent to the LLM (simple truncation, original article gets more room).
RESEARCH_MAX_CHARS_ORIGINAL=20000
RESEARCH_MAX_CHARS_PER_SOURCE=12000
RESEARCH_MAX_TOTAL_CHARS=60000
# USD per 1M tokens, JSON. Leave empty to use defaults from app/core/config.py.
# LLM_PRICING={"gpt-4.1-mini": {"input": 0.40, "output": 1.60}}

# --- Article writer ---
# Empty = OPENAI_RESEARCH_MODEL (-> OPENAI_CLASSIFIER_MODEL). A cheaper brief model + stronger writer works well,
# e.g. OPENAI_BRIEF_MODEL=gpt-4.1-mini, OPENAI_WRITER_MODEL=gpt-4.1
OPENAI_BRIEF_MODEL=
OPENAI_WRITER_MODEL=
WRITER_TIMEOUT_SECONDS=300
RESEARCH_TIMEOUT_SECONDS=300

# --- Trwała kolejka / worker ---
# Heartbeat musi być krótszy niż lease; czas w sekundach.
JOB_POLL_SECONDS=1
JOB_HEARTBEAT_SECONDS=10
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
JOB_CLASSIFY_TIMEOUT_SECONDS=180
JOB_RESEARCH_TIMEOUT_SECONDS=900
JOB_WRITE_TIMEOUT_SECONDS=900

# --- Article QA: empty model uses Research model ---
OPENAI_QA_MODEL=
QA_PASS_SCORE=85
QA_TIMEOUT_SECONDS=300
JOB_QA_ARTICLE_TIMEOUT_SECONDS=900

# Auto Fix + Approval
OPENAI_AUTO_FIX_MODEL=
AUTO_FIX_MAX_CHANGE_RATIO=0.35
AUTO_FIX_MAX_ITERATIONS=2
AUTO_FIX_TIMEOUT_SECONDS=300
JOB_AUTO_FIX_ARTICLE_TIMEOUT_SECONDS=900

# WordPress Publisher (stage 8). Use an Application Password, never the login password.
WORDPRESS_URL=
WORDPRESS_API_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
WORDPRESS_DEFAULT_STATUS=draft
WORDPRESS_DEFAULT_AUTHOR_ID=
WORDPRESS_DEFAULT_CATEGORY_ID=
WORDPRESS_SEO_PLUGIN=yoast
WORDPRESS_INSTANCE_ID=content-engine
WORDPRESS_ASSET_ROOT=/app/assets

# --- Logowanie ---
# Sesja w bazie, token w ciasteczku HttpOnly. W prod: COOKIE_DOMAIN=.example.com (wspólne dla app. i api.),
# COOKIE_SECURE=true, CORS_ORIGINS z dokładnym originem panelu (sprawdzany też jako ochrona CSRF).
SESSION_COOKIE_NAME=ce_session
SESSION_TTL_DAYS=14
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Dane są izolowane per workspace, ale wszyscy zużywają wspólny klucz OpenAI bez budżetów - w prod ustaw
# false i zakładaj konta przez `make create-user EMAIL=...` do czasu limitów kosztów.
ALLOW_REGISTRATION=true
# Limity: nieudane logowania per email/IP w oknie AUTH_WINDOW_MINUTES; rejestracje per IP na godzinę.
AUTH_MAX_FAILURES_PER_EMAIL=5
AUTH_MAX_FAILURES_PER_IP=20
AUTH_WINDOW_MINUTES=15
AUTH_MAX_REGISTRATIONS_PER_IP=5
AUTH_REGISTRATION_WINDOW_MINUTES=60

# --- Produkcja (docker-compose.prod.yml / make deploy) ---
# DATABASE_URL jest składany z POSTGRES_*; hasło bez znaków specjalnych URL, np. `openssl rand -hex 24`.
# Ustaw też publiczne NEXT_PUBLIC_API_URL i CORS_ORIGINS (np. https://api.example.com, https://app.example.com).
POSTGRES_USER=content
POSTGRES_PASSWORD=
POSTGRES_DB=content
# Adres:port na hoście. Domyślnie tylko localhost (za reverse proxy z TLS).
API_BIND=127.0.0.1:8000
WEB_BIND=127.0.0.1:3000
