APP_NAME="Content Engine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=content
DB_USERNAME=content
DB_PASSWORD=content

SESSION_DRIVER=redis
SESSION_COOKIE=ce_session
SESSION_LIFETIME=20160
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=log

ALLOW_REGISTRATION=false
DEFAULT_MONTHLY_BUDGET_USD=10

OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL="gpt-4.1-mini"
OPENAI_RESEARCH_MODEL="gpt-6.1-sol"
OPENAI_BRIEF_MODEL="gpt-4.1-mini"
OPENAI_WRITER_MODEL="gpt-6.1-sol"
OPENAI_QA_MODEL=gpt-4.1
OPENAI_AUTO_FIX_MODEL=gpt-4.1
# Embeddingi do wykrywania tego samego tematu z różnych RSS (część płatnego kroku „Ocena tematu”).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Podobieństwo (0–1), od którego temat trafia do grupy istniejącego; okno porównania w dniach.
TOPIC_SIMILARITY_THRESHOLD=0.86
TOPIC_WINDOW_DAYS=30
SEARCH_PROVIDER=manual
TAVILY_API_KEY=
RESEARCH_MAX_EXTRA_SOURCES=5
RESEARCH_MAX_CHARS_ORIGINAL=20000
RESEARCH_MAX_CHARS_PER_SOURCE=12000
RESEARCH_MAX_TOTAL_CHARS=60000
AUTOMATION_ENABLED=true
FETCH_MAX_AGE_DAYS=14

AI_PYTHON=/opt/ai/bin/python
AI_WORKDIR=/srv/ai
WORDPRESS_ALLOW_PRIVATE_URLS=false
# Źródła RSS: true tylko lokalnie (feedy w sieci Dockera). Na produkcji false – ochrona przed SSRF.
SOURCES_ALLOW_PRIVATE_URLS=false
# Opcjonalny jednorazowy import połączenia (make wordpress-import); po imporcie usuń hasło z pliku.
WORDPRESS_URL=
WORDPRESS_API_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Alerty kolejki (Slack/Discord webhook); puste = wyłączone.
ALERT_WEBHOOK_URL=
